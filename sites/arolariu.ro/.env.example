# In order to get a build up and running, you need to configure some environment variables.
# The preferred runtime contract is now exp-driven: the website resolves API URL,
# API auth secret, feature flags, and optional Resend settings from the exp service
# on the server. Only a narrow set of build/runtime env vars should remain primary.
#
# The legacy fallback values shown below are optional compatibility inputs. They are
# only used when exp is unavailable or in isolated test scenarios and should not be
# treated as the normal production runtime path.
#
# This is a hand-maintained, safe example owned by onboarding documentation — it is
# not a generated snapshot. Copy it to `.env` for local bare-metal development, or
# let `npm run setup` additively create the missing setup-owned entries below the
# first time you run it; setup never overwrites an existing entry. Both Clerk
# credentials may remain absent for ordinary non-CI `next dev`, where Clerk can
# use keyless development. CI, production, and explicitly configured Clerk
# runtimes require a valid mode-matched pair. Setup reports incomplete or
# invalid credentials as degraded but still completes successfully (exit code 0).
#
# If you copy this file to `.env` before running `npm run setup`, the Clerk keys
# below already exist (as empty values), so setup will not prompt you for them —
# fill in the publishable/secret pair by hand afterward, or delete those two lines
# from your copy first if you want setup's interactive prompt instead.
#
# NEVER submit real secrets in any versioning system. If you do, rotate them ASAP.

# ----------------------------------------------------------- #

# Site Configuration Start
# SITE_ENV is either "DEVELOPMENT" or "PRODUCTION" — core local default additively prepared by `npm run setup`
SITE_ENV=DEVELOPMENT
# SITE_NAME is the name of the site, e.g. "dev.arolariu.ro" or "arolariu.ro" — core local default additively prepared by `npm run setup`
SITE_NAME=dev.arolariu.ro
# SITE_URL is the URL of the site, e.g. "https://localhost:3000" or "https://arolariu.ro" — core local default additively prepared by `npm run setup`
SITE_URL=https://localhost:3000
# Site Configuration End

# Accepted Authentication Configuration Start
# Clerk publishable key (pk_test_... or pk_live_...). Leave both keys empty only for ordinary non-CI keyless development.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Matching Clerk secret key (sk_test_... or sk_live_...). Required with the publishable key and outside keyless development.
CLERK_SECRET_KEY=
# Accepted Authentication Configuration End

# Accepted Azure Runtime Identity Start
# Set on Azure App Service to enable managed identity + https://exp.arolariu.ro routing.
AZURE_CLIENT_ID=
# Optional Azure deployment identifier.
AZURE_TENANT_ID=
# Optional Azure deployment identifier.
AZURE_SUBSCRIPTION_ID=
# Accepted Azure Runtime Identity End

# Metadata Configuration Start
# The timestamp of the build, e.g. "2025-06-08T09:02:12.412Z"
TIMESTAMP=
# The commit SHA of the build, e.g. "c4d9d9ade7e30908b49d7c6d64b1328e4b31eb4b"
COMMIT_SHA=
# Set to "true" to use CDN for static assets prefix, otherwise "false" — core local default additively prepared by `npm run setup`
USE_CDN=false
# Metadata Configuration End
