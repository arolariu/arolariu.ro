# In order to get a build up and running, you need to configure some environment variables.
# The preferred runtime contract is now exp-driven: the website resolves API URL,
# API auth secret, feature flags, and optional Resend settings from the exp service
# on the server. Only a narrow set of build/runtime env vars should remain primary.
#
# The legacy fallback values shown below are optional compatibility inputs. They are
# only used when exp is unavailable or in isolated test scenarios and should not be
# treated as the normal production runtime path.
#
# This is a hand-maintained, safe example owned by onboarding documentation — it is
# not a generated snapshot. Copy it to `.env` for local bare-metal development, or
# let `npm run setup` additively create the missing setup-owned entries below the
# first time you run it; setup never overwrites an existing entry. Missing or
# invalid Clerk credentials leave authenticated website features degraded, but
# `npm run setup` still completes successfully (exit code 0).
#
# NEVER submit real secrets in any versioning system. If you do, rotate them ASAP.

# ----------------------------------------------------------- #

# Site Configuration Start
SITE_ENV=DEVELOPMENT # is either "DEVELOPMENT" or "PRODUCTION" — core local default additively prepared by `npm run setup`
SITE_NAME=dev.arolariu.ro # the name of the site, e.g. "dev.arolariu.ro" or "arolariu.ro" — core local default additively prepared by `npm run setup`
SITE_URL=https://localhost:3000 # the URL of the site, e.g. "https://localhost:3000" or "https://arolariu.ro" — core local default additively prepared by `npm run setup`
# Site Configuration End

# Accepted Authentication Configuration Start
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY= # Optional Clerk publishable key (pk_test_... or pk_live_...). Leave empty for degraded, unauthenticated-only local development.
CLERK_SECRET_KEY= # Optional Clerk secret key (sk_test_... or sk_live_...). Must share the same test/live mode as the publishable key above.
# Accepted Authentication Configuration End

# Accepted Azure Runtime Identity Start
AZURE_CLIENT_ID= # Set on Azure App Service to enable managed identity + https://exp.arolariu.ro routing.
AZURE_TENANT_ID= # Optional Azure deployment identifier.
AZURE_SUBSCRIPTION_ID= # Optional Azure deployment identifier.
# Accepted Azure Runtime Identity End

# Metadata Configuration Start
TIMESTAMP= # The timestamp of the build, e.g. "2025-06-08T09:02:12.412Z"
COMMIT_SHA= # The commit SHA of the build, e.g. "c4d9d9ade7e30908b49d7c6d64b1328e4b31eb4b"
USE_CDN=false # Set to "true" to use CDN for static assets prefix, otherwise "false" — core local default additively prepared by `npm run setup`
# Metadata Configuration End
