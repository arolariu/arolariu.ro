{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "**/*.d.ts",
    "**/*.spec.*",
    "**/*.test.*",
    "**/*.stories.*",
    "**/node_modules/**",
    "**/.next/**",
    "**/storybook-static/**",
    "src/__generated__/**",
    "src/generated/**",
    "src/app/**",
    "src/components/Footer.tsx",
    "src/components/Header.tsx",
    "src/lib/currency/**"
  ]
}
