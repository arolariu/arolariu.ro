<Project>
  <!--
    Central Build Configuration for arolariu.ro Backend API
    This file is automatically imported by all project files in this directory and subdirectories.
  -->

  <PropertyGroup Label="Common Project Settings">
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableCodeStyleSeverity>True</EnableCodeStyleSeverity>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <SignAssembly>False</SignAssembly>
  </PropertyGroup>

  <!--
    Compiler strictness.

    These MUST live in an unconditional PropertyGroup. Directory.Build.props is imported by
    Microsoft.Common.props before $(Configuration) and $(Platform) receive their defaults, so a
    PropertyGroup guarded by Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'" evaluates
    that expression as '|' and is silently skipped — the settings never apply and the build looks
    strict while enforcing nothing. Debug and Release previously declared identical values, so a
    single unconditional group is exactly equivalent to the intent, minus the failure mode.
  -->
  <PropertyGroup Label="Compiler Strictness">
    <WarningLevel>9999</WarningLevel>
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
    <CheckForOverflowUnderflow>True</CheckForOverflowUnderflow>
    <Deterministic>True</Deterministic>
    <!-- S1135: TODO comments. NU1902/NU1903: transitive package vulnerability advisories. -->
    <NoWarn>S1135, NU1903, NU1902</NoWarn>
  </PropertyGroup>

  <!-- AOT & Trimming Settings for Libraries -->
  <PropertyGroup Condition="'$(OutputType)' == 'Library' AND '$(IsTestProject)' != 'true'"
    Label="Library Optimization Settings">
    <IsTrimmable>True</IsTrimmable>
    <IsAotCompatible>True</IsAotCompatible>
  </PropertyGroup>

  <!-- AOT & Trimming Settings for Web Projects -->
  <PropertyGroup Condition="'$(OutputType)' == 'Exe' OR '$(IsAspNetCoreProject)' == 'true'"
    Label="Web Project Optimization Settings">
    <IsTrimmable>False</IsTrimmable>
    <IsAotCompatible>False</IsAotCompatible>
  </PropertyGroup>

  <!-- Test Project Settings -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'" Label="Test Project Settings">
    <IsPackable>false</IsPackable>
    <IsTrimmable>False</IsTrimmable>
    <IsAotCompatible>False</IsAotCompatible>
  </PropertyGroup>

  <!-- Enable Central Package Management -->
  <PropertyGroup Label="Central Package Management">
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Solution-wide Metadata -->
  <PropertyGroup Label="Assembly Metadata">
    <Company>arolariu.ro</Company>
    <Authors>Alexandru Olariu</Authors>
    <Copyright>Copyright © 2025 Alexandru Olariu</Copyright>
    <PackageProjectUrl>https://arolariu.ro</PackageProjectUrl>
    <RepositoryUrl>https://github.com/arolariu/arolariu.ro</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
