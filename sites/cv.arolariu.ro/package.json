{
  "name": "@arolariu/cv",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:api": "node ../../scripts/swa/build-api.ts cv",
    "check:api": "tsc --project api/tsconfig.json --noEmit",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "npm run test:unit",
    "test:unit": "svelte-kit sync && npm run test:vitest",
    "test:vitest": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "svelte-kit sync && vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:a11y": "playwright test tests/accessibility.spec.ts",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "*",
    "@sveltejs/adapter-static": "*",
    "@sveltejs/kit": "*",
    "@sveltejs/vite-plugin-svelte": "*",
    "@testing-library/jest-dom": "*",
    "@testing-library/svelte": "*",
    "@types/node": "*",
    "@vitejs/plugin-react": "*",
    "@vitest/coverage-v8": "*",
    "axe-core": "*",
    "esbuild": "*",
    "happy-dom": "*",
    "sass": "*",
    "set-cookie-parser": "*",
    "svelte": "*",
    "svelte-check": "*",
    "typescript": "*",
    "vite": "*",
    "vitest": "*"
  }
}
