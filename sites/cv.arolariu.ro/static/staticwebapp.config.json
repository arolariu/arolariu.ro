{
  "trailingSlash": "never",
  "routes": [
    {"route": "/rest/json", "rewrite": "/api/cv-json"},
    {"route": "/_app/immutable/*", "headers": {"Cache-Control": "public, max-age=31536000, immutable"}}
  ],
  "platform": {"apiRuntime": "node:26"},
  "responseOverrides": {"404": {"rewrite": "/404.html"}}
}
