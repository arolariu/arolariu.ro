# =============================================================================
# .dockerignore — build context for images built from the REPOSITORY ROOT
# =============================================================================
# Two build paths use the repo root as context, so this file governs both:
#   - CI website build:  docker build -f infra/containers/Dockerfile.frontend .
#     (.github/workflows/official-website-build.yml)
#   - npm run containers:build -> scripts/container-runtime/image.ts, which
#     builds frontend, backend, cv AND exp from infra/containers/Dockerfile.*
#     with context "."
#
# CI additionally builds api and exp with their OWN directory as context
# (see official-api-trigger.yml / official-exp-trigger.yml); those builds use
# sites/api.arolariu.ro/.dockerignore and sites/exp.arolariu.ro/.dockerignore.
#
# Before excluding anything, check it is not COPYed by ANY of the four
# infra/containers/Dockerfile.* files. Note that Docker patterns without `**`
# match only at the context root (e.g. `*.md` and `docs/` do not affect
# sites/api.arolariu.ro/**).

# --- VCS (a few git files are re-included for build metadata) ---
**/.git
!.git/HEAD
!.git/config
!.git/packed-refs
!.git/refs/heads/**

# --- Editor / IDE ---
**/.vs
**/.vscode
**/*.*proj.user

# --- Container definitions (passed via -f, not needed inside the context) ---
**/.dockerignore
**/docker-compose*
**/Dockerfile*

# --- Secrets & environment (website .env files are generated by `npm run generate`) ---
**/.env
!sites/arolariu.ro/.env
!sites/arolariu.ro/.env.local

# --- Dependencies ---
**/node_modules
node_modules/
**/npm-debug.log
npm-debug.log*

# --- Build outputs ---
.next/
out/
build/
dist/
**/bin/
**/obj/
.nx/
.svelte-kit/
.docusaurus/
artifacts/
**/*.tsbuildinfo

# --- Testing ---
coverage/
.nyc_output/
.storybook/
code-cov/
*.lcov
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
test-results/
TestResults/
playwright-report/
storybook-static/

# --- Docs & stories ---
*.md
docs/
**/*.stories.ts
**/*.stories.tsx

# --- AI tooling (not needed in container) ---
.claude/
.copilot/
.mcp.json
.claudeignore
.copilotignore
.superpowers/
docs/superpowers/
.impeccable/
.worktrees/

# --- Python runtime artifacts ---
__pycache__/
.venv/
.ruff_cache/
**/*.pyc

# --- Transient ---
logs/
temp/
tmp/
*.log
