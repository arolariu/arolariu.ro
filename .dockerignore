# =============================================================================
# .dockerignore — build context for the ROOT context image (sites/arolariu.ro)
# =============================================================================
# sites/api.arolariu.ro and sites/exp.arolariu.ro build from their own
# directories and have their own .dockerignore files.
#
# The website Dockerfile only copies: package.json, package-lock.json,
# tsconfig.json, vitest.config.ts, packages/components/ and sites/arolariu.ro/.
# Everything excluded below is therefore never needed at build time.

# --- VCS (a few git files are re-included for build metadata) ---
**/.git
!.git/HEAD
!.git/config
!.git/packed-refs
!.git/refs/heads/**

# --- Editor / IDE ---
**/.vs
**/.vscode
**/*.*proj.user

# --- Container definitions (passed via -f, not needed inside the context) ---
**/.dockerignore
**/docker-compose*
**/Dockerfile*

# --- Secrets & environment (website .env files are generated by `npm run generate`) ---
**/.env
!sites/arolariu.ro/.env
!sites/arolariu.ro/.env.local

# --- Dependencies ---
**/node_modules
node_modules/
**/npm-debug.log
npm-debug.log*

# --- Build outputs ---
.next/
out/
build/
dist/
**/bin/
**/obj/
.nx/
.svelte-kit/
.docusaurus/
artifacts/
**/*.tsbuildinfo

# --- Testing ---
coverage/
.nyc_output/
.storybook/
code-cov/
*.lcov
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
test-results/
TestResults/
playwright-report/
storybook-static/

# --- Docs & stories ---
*.md
docs/
**/*.stories.ts
**/*.stories.tsx

# --- AI tooling (not needed in container) ---
.claude/
.copilot/
.mcp.json
.claudeignore
.copilotignore
.superpowers/
docs/superpowers/
.impeccable/
.worktrees/

# --- Python runtime artifacts ---
__pycache__/
.venv/
.ruff_cache/
**/*.pyc

# --- Transient ---
logs/
temp/
tmp/
*.log
