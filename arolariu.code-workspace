{
  // Single root: the monorepo itself. Do NOT re-add `sites`, `packages`, `docs`
  // etc. as sibling folders — they live under "." and VS Code would show every
  // file twice.
  "folders": [{"path": "."}],
  "settings": {
    "dotnet.defaultSolution": "arolariu.slnx",
    "dotnet.preferCSharpExtension": true,
  },
  // Extension recommendations intentionally omitted: host recommendations live
  // in .vscode/extensions.json, while specialized container extensions live in
  // .devcontainer/*/devcontainer.json. Duplicating these lists would drift.
}
