# =============================================================================
# .copilotignore — exclude noise from GitHub Copilot CLI context
# =============================================================================
# Keep in sync with .claudeignore (same intent, different tool) and with the
# "transient artifacts" block of .gitignore.

# --- Build artifacts & caches ---
node_modules/
dist/
build/
out/
_site/
bin/
obj/
.next/
.nx/
.svelte-kit/
.docusaurus/
.turbo/
.cache/
.vs/
storybook-static/
coverage/
code-cov/
test-results/
TestResults/
playwright-report/
artifacts/
logs/
temp/
tmp/
__generated__/
*.tsbuildinfo

# --- Agent working artifacts ---
.superpowers/
docs/superpowers/
.impeccable/
.worktrees/

# --- Python runtime artifacts ---
__pycache__/
.venv/
.ruff_cache/
*.pyc

# --- Secrets & environment files ---
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
**/appsettings.Development.json
**/appsettings.Production.json

# --- Generated & lock files ---
package-lock.json

# --- Large assets & non-code ---
readme/
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.ico
*.pdf
*.woff
*.woff2
*.ttf
*.eot

# --- IDE & tool configuration ---
.vscode/
*.code-workspace
settings.VisualStudio.json
