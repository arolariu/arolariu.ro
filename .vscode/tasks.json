{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Selfhost: up",
      "type": "shell",
      "command": "bash",
      "args": ["infra/Local/selfhost-start.sh"],
      "windows": { "command": "infra\\Local\\selfhost-start.bat", "args": [] },
      "problemMatcher": []
    },
    {
      "label": "Selfhost: down",
      "type": "shell",
      "command": "bash",
      "args": ["infra/Local/selfhost-stop.sh"],
      "windows": { "command": "infra\\Local\\selfhost-stop.bat", "args": [] },
      "problemMatcher": []
    },
    {
      "label": "Lint",
      "type": "shell",
      "command": "npm run lint",
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "Format",
      "type": "shell",
      "command": "npm run format",
      "problemMatcher": []
    },
    {
      "label": "Test (unit)",
      "type": "shell",
      "command": "npm run test:unit",
      "problemMatcher": []
    },
    {
      "label": "Generate",
      "type": "shell",
      "command": "npm run generate",
      "problemMatcher": []
    }
  ]
