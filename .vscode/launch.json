{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Full stack (Aspire)",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/tooling/AppHost/AppHost.csproj",
      "launchSettingsProfile": "AppHost"
    },
    {
      "name": "🚀 Full stack (no debug)",
      "type": "dotnet",
      "request": "launch",
      "noDebug": true,
      "projectPath": "${workspaceFolder}/tooling/AppHost/AppHost.csproj",
      "launchSettingsProfile": "AppHost"
    },
    {
      "name": "🌐 Website only (standalone)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/sites/arolariu.ro"
    },
    {
      "name": "🔧 API only (standalone)",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/sites/api.arolariu.ro/src/Core/arolariu.Backend.Core.csproj"
    },
    {
      "name": "🔗 Attach to running .NET process",
      "type": "dotnet",
      "request": "attach"
    },
    {
      "name": "🧭 Next.js: Debug Client-Side (Edge)",
      "type": "msedge",
      "request": "launch",
      "url": "https://localhost:3000",
      "webRoot": "${workspaceFolder}/sites/arolariu.ro",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack://_N_E/*": "${webRoot}/*",
        "webpack:///./*": "${webRoot}/*",
        "webpack:///./~/*": "${webRoot}/node_modules/*"
      }
    },
    {
      "name": "📚 Launch DocFX site",
      "type": "node-terminal",
      "request": "launch",
      "command": "docfx build sites/docs.arolariu.ro/docfx.json --serve",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "🐍 Python: exp FastAPI Debug",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["main:app", "--reload", "--host", "127.0.0.1", "--port", "5002"],
      "cwd": "${workspaceFolder}/sites/exp.arolariu.ro",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/sites/exp.arolariu.ro",
        "INFRA": "local"
      }
    },
    {
      "name": "🪡 Attach to Next.js (Aspire)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "continueOnAttach": true,
      "localRoot": "${workspaceFolder}/sites/arolariu.ro",
      "remoteRoot": "${workspaceFolder}/sites/arolariu.ro",
      "presentation": { "group": "10-aspire-attach", "order": 1 }
    },
    {
      "name": "🪡 Attach to cv SvelteKit (Aspire)",
      "type": "node",
      "request": "attach",
      "port": 9230,
      "restart": true,
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "continueOnAttach": true,
      "localRoot": "${workspaceFolder}/sites/cv.arolariu.ro",
      "remoteRoot": "${workspaceFolder}/sites/cv.arolariu.ro",
      "presentation": { "group": "10-aspire-attach", "order": 2 }
    },
    {
      "name": "🪡 Attach to docs Docusaurus (Aspire)",
      "type": "node",
      "request": "attach",
      "port": 9231,
      "restart": true,
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "continueOnAttach": true,
      "localRoot": "${workspaceFolder}/sites/docs.arolariu.ro",
      "remoteRoot": "${workspaceFolder}/sites/docs.arolariu.ro",
      "presentation": { "group": "10-aspire-attach", "order": 3 }
    },
    {
      "name": "🪡 Attach to status SvelteKit (Aspire)",
      "type": "node",
      "request": "attach",
      "port": 9232,
      "restart": true,
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "continueOnAttach": true,
      "localRoot": "${workspaceFolder}/sites/status.arolariu.ro",
      "remoteRoot": "${workspaceFolder}/sites/status.arolariu.ro",
      "presentation": { "group": "10-aspire-attach", "order": 4 }
    }
  ],
  "compounds": [
    {
      "name": "🪡 Full stack + Node debug",
      "configurations": [
        "🚀 Full stack (Aspire)",
        "🪡 Attach to Next.js (Aspire)",
        "🪡 Attach to cv SvelteKit (Aspire)",
        "🪡 Attach to docs Docusaurus (Aspire)",
        "🪡 Attach to status SvelteKit (Aspire)"
      ],
      "stopAll": true
    }
  ]
}
