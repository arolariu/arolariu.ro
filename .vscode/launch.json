{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Full stack (Aspire)",
      "type": "aspire",
      "request": "launch",
      "program": "${workspaceFolder}/tooling/AppHost",
      "command": "run",
      "debuggers": {
        "apphost": {},
        "project": { "console": "integratedTerminal" },
        "node":    { "skipFiles": ["<node_internals>/**"] },
        "python":  { "justMyCode": false }
      }
    },
    {
      "name": "🚀 Full stack (no debug)",
      "type": "aspire",
      "request": "launch",
      "noDebug": true,
      "program": "${workspaceFolder}/tooling/AppHost",
      "command": "run"
    },
    {
      "name": "🌐 Website only (standalone)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/sites/arolariu.ro"
    },
    {
      "name": "🔧 API only (standalone)",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/sites/api.arolariu.ro/src/Core/arolariu.Backend.Core.csproj"
    },
    {
      "name": "🔗 Attach to running .NET process",
      "type": "dotnet",
      "request": "attach"
    },
    {
      "name": "🧭 Next.js: Debug Client-Side (Edge)",
      "type": "msedge",
      "request": "launch",
      "url": "https://localhost:3000",
      "webRoot": "${workspaceFolder}/sites/arolariu.ro",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack://_N_E/*": "${webRoot}/*",
        "webpack:///./*": "${webRoot}/*",
        "webpack:///./~/*": "${webRoot}/node_modules/*"
      }
    },
    {
      "name": "📚 Launch DocFX site",
      "type": "node-terminal",
      "request": "launch",
      "command": "docfx build sites/docs.arolariu.ro/docfx.json --serve",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "🐍 Python: exp FastAPI Debug",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["main:app", "--reload", "--host", "127.0.0.1", "--port", "5002"],
      "cwd": "${workspaceFolder}/sites/exp.arolariu.ro",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/sites/exp.arolariu.ro",
        "INFRA": "local"
      }
    },
    {
      "name": "🪡 Attach to Next.js (Aspire)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true,
      "continueOnAttach": true,
      "localRoot": "${workspaceFolder}/sites/arolariu.ro",
      "remoteRoot": "${workspaceFolder}/sites/arolariu.ro",
      "presentation": { "group": "10-aspire-attach", "order": 1 }
    }
  ],
  "compounds": []
}
