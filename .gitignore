# =============================================================================
# .gitignore — arolariu.ro monorepo
# =============================================================================
# Directory patterns are written as `dir/` (not `**/dir/**`) so that Git can
# prune the whole directory during traversal. `**/dir/**` only matches the
# files inside and forces Git — and every tool that reuses gitignore semantics
# (Prettier, ESLint, Nx) — to walk the entire tree.

# --- Transient artifacts ---
tmp/
temp/
*.lscache
node_modules/
_site/
obj/
bin/
dist/
build/
out/
output/
logs/
code-cov/
coverage/
test-results/
TestResults/
playwright-report/
storybook-static/
.next/
.nx/
.svelte-kit/
.docusaurus/
.auth/
__generated__/
_generated/
*.tsbuildinfo
**/.DS_Store
sites/docs.arolariu.ro/docs/monorepo/
**/test-file.txt

# --- Build output named `artifacts` (anchored: `.github/scripts/helpers/artifacts/`
#     is SOURCE code, so a blanket `artifacts/` rule must never be used here) ---
/artifacts/
/.github/scripts/artifacts/

# --- Visual Studio: exclude contents, not the directory itself, so the
#     re-includes below still work (Git cannot un-ignore a file inside an
#     ignored directory) ---
.vs/*
!.vs/settings.vssettings
!.vs/README.md

# --- Agent working artifacts (never committed) ---
.superpowers/
docs/superpowers/
.impeccable/
.worktrees/

# --- Windows shell artifacts ---
nul

# --- Editor user settings ---
*.DotSettings.user
.claude/settings.local.json

# --- Merge conflict backups ---
*.orig
*.bak

# --- Environment variables ---
**/.env
**/.env.*
!**/.env.example

# --- Python runtime artifacts ---
**/local.settings.json
__pycache__/
*.pyc
.venv/
.python_packages/
*.egg-info/
.ruff_cache/

# --- arolariu.ro website ---
sites/arolariu.ro/certificates
sites/arolariu.ro/messages/*.d.json.ts
sites/arolariu.ro/licenses.json
sites/arolariu.ro/next-env.d.ts
sites/arolariu.ro/src/data/taxonomies/*.min.json
**/e2e-storage-state.json

# --- Generated taxonomy artifacts ---
sites/api.arolariu.ro/src/Invoices/Resources/Taxonomies/*.min.json

# --- exp local config (may contain secrets for local development) ---
sites/exp.arolariu.ro/config.json
sites/exp.arolariu.ro/config.docker.json
sites/exp.arolariu.ro/config.aspire.json
